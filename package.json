{
  "name": "stagenum",
  "version": "0.1.0",
  "private": true,
  "description": "Stagenum production application foundation",
  "type": "module",
  "engines": {
    "node": "22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "lint": "oxlint app src scripts tests next.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
